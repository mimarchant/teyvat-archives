---
import { render } from 'astro:content';
import { contentRevision } from '../lib/content-revision';
import { isSearchableArticle } from '../lib/search-visibility';
import SiteLayout from '../layouts/SiteLayout.astro';
import SaveToLibrary from '../components/SaveToLibrary.vue';
import ReadingProgress from '../components/editorial/ReadingProgress.vue';
import '../styles/reading-progress.css';

import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'chronicles' | 'entities' | 'quests' | 'mysteries'> }

const { entry } = Astro.props;
const isChronicle = entry.collection === 'chronicles';
const savedId = isChronicle ? entry.id : `${entry.collection}:${entry.id}`;
const articleLabels = {
  chronicles: { kicker: 'CRÓNICA HISTÓRICA', backHref: '/cronicas/', backLabel: 'Volver a Crónicas' },
  entities: { kicker: 'FICHA DE ENTIDAD', backHref: '/entidades/', backLabel: 'Volver al Archivo' },
  quests: { kicker: 'FICHA DE MISIÓN', backHref: '/misiones/', backLabel: 'Volver a Misiones' },
  mysteries: { kicker: 'EXPEDIENTE ABIERTO', backHref: '/misterios/', backLabel: 'Volver a Misterios' },
} as const;
const articleLabel = articleLabels[entry.collection];
const { Content, headings } = await render(entry);
const revision = await contentRevision(entry.body ?? '', headings, entry.data.updatedAt.toISOString());
const date = entry.data.updatedAt.toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const statusLabel = entry.data.reviewStatus === 'verified' ? 'Revisión completada' : entry.data.reviewStatus === 'needs-review' ? 'Revisión pendiente' : 'Borrador editorial';
const classificationLabel = {
  canon: 'Canon',
  interpretation: 'Interpretación',
  theory: 'Teoría',
  unresolved: 'Sin resolver',
}[entry.data.classification];
const spoilerLabel = entry.data.spoilerLevel === 'none' ? 'Sin spoilers' : `Hasta ${entry.data.spoilerLevel}`;
const searchable = isSearchableArticle(entry.data);
---
<SiteLayout title={`${entry.data.title} — Teyvat Archives`} description={entry.data.summary}>
  <article class="article-shell page-wrap" data-pagefind-ignore={searchable ? undefined : true}>
    <a class="back-link" href={articleLabel.backHref}>← {articleLabel.backLabel}</a>

    <header class="article-header article-header--editorial">
      <div class="article-kicker-row">
        <p class="eyebrow"><span></span> {articleLabel.kicker}</p>
        <span class={`review-status review-status--${entry.data.reviewStatus}`}>{statusLabel}</span>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="article-summary">{entry.data.summary}</p>
      <div class="article-actions">
        <SaveToLibrary client:load entryId={savedId} />
        <span class="article-reading-time">LECTURA EDITORIAL</span>
      </div>
      <div class="article-meta">
        <span>ACTUALIZADO: {date}</span>
        <span>CLASIFICACIÓN: {classificationLabel.toUpperCase()}</span>
        <span>SPOILERS: {spoilerLabel.toUpperCase()}</span>
      </div>
    </header>

    <div class="article-layout article-layout--editorial">
      <aside class="article-sidebar" aria-label="Navegación del artículo" data-pagefind-ignore>
        <p class="eyebrow">EN ESTA PÁGINA</p>
        <nav class="article-toc">
          {headings.filter((heading) => heading.depth === 2).map((heading) => (
            <a href={`#${heading.slug}`}>{heading.text}</a>
          ))}
        </nav>
        <ReadingProgress client:load collection={entry.collection} entryId={entry.id} revision={revision} />
        <div class="editorial-note">
          <span aria-hidden="true">✧</span>
          <p>Las afirmaciones deben estar respaldadas por fuentes identificables del juego.</p>
        </div>
      </aside>

      <div class="article-main" id="contenido-articulo">
        <div class="prose prose--editorial"><Content /></div>
        <section class="source-register" id="registro-de-fuentes">
          <div class="source-register__heading">
            <p class="eyebrow">TRAZABILIDAD</p>
            <h2>Registro de fuentes</h2>
          </div>
          {entry.data.sources.length > 0 ? (
            <ol>
              {entry.data.sources.map((source) => (
                <li><strong>{source.title}</strong><span>{source.type.toUpperCase()} {source.gameVersion ? `· Versión ${source.gameVersion}` : ''}</span><p>{source.supports}</p>{source.reference && <small>{source.reference}</small>}</li>
              ))}
            </ol>
          ) : (
            <p class="source-empty">Esta entrada aún no tiene fuentes verificadas. No se publicarán conclusiones hasta completar su revisión.</p>
          )}
        </section>
      </div>
    </div>
  </article>
</SiteLayout>
