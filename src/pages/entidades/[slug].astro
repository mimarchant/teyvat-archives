---
import { getCollection } from 'astro:content';
import ArchiveArticle from '../../layouts/ArchiveArticle.astro';
export async function getStaticPaths() {
  return (await getCollection('entities')).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<ArchiveArticle entry={entry} />
