---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SearchExplorer from '../../components/search/SearchExplorer.vue';
import '../../styles/search.css';

const query = Astro.url.searchParams.get('q')?.trim() ?? '';
---
<SiteLayout
  title="Buscar en el archivo — Teyvat Archives"
  description="Encuentra crónicas, personajes, lugares y misterios dentro de Teyvat Archives."
>
  <section class="search-page page-wrap" data-pagefind-ignore>
    <a class="back-link" href="/">← Volver al archivo</a>
    <header class="search-page__header">
      <p class="eyebrow"><span></span> CONSULTA DEL ARCHIVO</p>
      <h1>Buscar en <em>Teyvat.</em></h1>
      <p>Busca nombres, acontecimientos, civilizaciones y conceptos. Los resultados se construyen a partir del contenido editorial publicado.</p>
    </header>
    <SearchExplorer client:load initialQuery={query} />
    <p class="search-page__note">Los borradores editoriales no aparecen en los resultados. Cada entrada publicada conserva su clasificación y sus referencias.</p>
  </section>
</SiteLayout>
