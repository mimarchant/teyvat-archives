---
import SiteLayout from '../../layouts/SiteLayout.astro';
const query = Astro.url.searchParams.get('q')?.trim() ?? '';
---
<SiteLayout title="Buscar — Teyvat Archives">
  <section class="article-shell page-wrap">
    <p class="eyebrow">EL ARCHIVO ESTÁ ABIERTO</p>
    <h1 style="font:500 clamp(48px,7vw,76px)/1 var(--serif);margin:18px 0">Buscar en el archivo</h1>
    <form class="search-form" action="/buscar/" style="width:min(560px,100%);margin:30px 0 50px;border-color:var(--gold)">
      <label class="sr-only" for="q">Buscar en el archivo</label>
      <input id="q" name="q" type="search" value={query} placeholder="Personaje, lugar, acontecimiento..." />
      <button type="submit" aria-label="Buscar">↗</button>
    </form>
    <p style="color:var(--muted);max-width:560px">{query ? `La búsqueda de “${query}” todavía no está conectada a un índice.` : 'La búsqueda global se incorporará en una siguiente etapa, cuando exista un primer conjunto de entradas editoriales verificadas.'}</p>
    <a class="text-link" href="/">← Volver al inicio</a>
  </section>
</SiteLayout>
