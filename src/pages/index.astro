---
import SiteLayout from '../layouts/SiteLayout.astro';
import { atlasEntries } from '../data/atlas';
import { archonQuests } from '../data/archon-quests';
import { homeJourneyStages } from '../data/home-journey';
import '../styles/home-atlas.css';

const nationEntries = atlasEntries.filter((entry) => entry.category === 'nation');
---
<SiteLayout title="Teyvat Archives — The Living Archive" description="Explora la historia, las civilizaciones y los misterios de Teyvat.">
  <section class="hero">
    <div class="hero-art" aria-hidden="true"></div>
    <div class="hero-content page-wrap">
      <p class="eyebrow"><span></span> UN ARCHIVO VIVO DE TEYVAT</p>
      <h1>Every story<br /><em>leaves a trace.</em></h1>
      <p class="hero-description">La historia de Teyvat está escrita en sus ruinas, sus leyendas y las personas que aún recuerdan. Sigue cada rastro.</p>
      <div class="hero-actions">
        <a class="button button--gold" href="/cronicas/">Comenzar a explorar <span>↗</span></a>
        <a class="text-link" href="#atlas">Descubrir el Atlas <span>→</span></a>
      </div>
      <div class="hero-index"><span>ARCHIVO Nº 0001</span><span>UNA HISTORIA AÚN INCOMPLETA</span></div>
    </div>
    <div class="hero-side-note" aria-hidden="true">THE WORLD OF TEYVAT · EST. UNKNOWN</div>
  </section>

  <section class="intro-strip page-wrap">
    <div class="intro-symbol">✧</div>
    <p>Un lugar para conectar las piezas.<br /><span>Desde el origen del mundo hasta los secretos que todavía esperan ser descubiertos.</span></p>
    <a href="#archivo" class="round-link" aria-label="Explorar el archivo">↘</a>
  </section>

  <section id="cronicas" class="section page-wrap">
    <div class="section-heading">
      <div><p class="eyebrow">01 / LA HISTORIA</p><h2>Crónicas de <em>Teyvat</em></h2></div>
      <a class="text-link" href="/cronicas/">Ver todas las crónicas <span>→</span></a>
    </div>
    <div class="feature-grid">
      <a class="feature-card feature-card--large" href="/cronicas/khaenriah/">
        <div class="feature-image feature-image--ruins"></div>
        <div class="feature-overlay"></div>
        <div class="feature-meta"><span>CRÓNICA HISTÓRICA</span><span>TESTIMONIO REVISADO</span></div>
        <div class="feature-copy"><p class="eyebrow">CIVILIZACIONES PERDIDAS</p><h3>Khaenri'ah</h3><p>Una lectura revisada de un testimonio histórico, con fuentes y límites explícitos.</p><span class="feature-cta">Explorar la crónica <b>↗</b></span></div>
      </a>
      <div class="feature-stack">
        <article class="mini-card mini-card--timeline"><p class="eyebrow">CRONOLOGÍA JUGABLE</p><h3>52 actos<br />documentados</h3><p>Del prólogo de Mondstadt al capítulo vigente de Snezhnaya.</p><a href="/misiones/arconte/" class="arrow-link" aria-label="Explorar las Misiones de Arconte">↗</a><span class="mini-decoration">1.0 → 7.2</span></article>
        <article class="mini-card mini-card--origins"><p class="eyebrow">ORÍGENES</p><h3>Antes de<br />la memoria</h3><p>El mundo antiguo y las preguntas que aún no tienen respuesta.</p><a href="/misterios/" class="arrow-link" aria-label="Explorar los misterios">↗</a><span class="mini-decoration">✧</span></article>
      </div>
    </div>
  </section>

  <section id="archivo" class="archive-band">
    <div class="page-wrap">
      <div class="section-heading section-heading--light"><div><p class="eyebrow">02 / CONSULTA</p><h2>El <em>Archivo</em></h2></div><p class="section-aside">Personajes, facciones, conceptos y entidades.<br />Cada entrada es una pieza del relato.</p></div>
      <div class="archive-grid">
        <a class="archive-item" href="/entidades/?tipo=character"><span class="archive-icon">♙</span><span class="archive-number">001</span><h3>Personajes</h3><p>Vidas, vínculos y destinos.</p><span class="archive-arrow">↗</span></a>
        <a class="archive-item" href="/entidades/?tipo=faction"><span class="archive-icon">⌂</span><span class="archive-number">002</span><h3>Facciones</h3><p>Órdenes, grupos y alianzas.</p><span class="archive-arrow">↗</span></a>
        <a class="archive-item" href="/entidades/?tipo=location"><span class="archive-icon">✧</span><span class="archive-number">003</span><h3>Lugares</h3><p>Ciudades, puertos y escenarios.</p><span class="archive-arrow">↗</span></a>
        <a class="archive-item" href="/entidades/?tipo=concept"><span class="archive-icon">◇</span><span class="archive-number">004</span><h3>Conceptos</h3><p>Ideas que sostienen el mundo.</p><span class="archive-arrow">↗</span></a>
      </div>
    </div>
  </section>

  <section id="misiones" class="journey-band">
    <div class="page-wrap">
      <div class="section-heading">
        <div><p class="eyebrow">03 / EL VIAJE DOCUMENTADO</p><h2>Misiones de <em>Arconte</em></h2></div>
        <a class="text-link" href="/misiones/arconte/">Ver los {archonQuests.length} actos <span>→</span></a>
      </div>
      <div class="journey-intro">
        <p>Una secuencia verificable de las misiones publicadas, organizada por etapa y versión. No sustituye una cronología de la historia antigua de Teyvat.</p>
        <span>PRÓLOGO · VERSIÓN 1.0</span>
        <span>CAPÍTULO VIGENTE · VERSIÓN 7.2</span>
      </div>
      <ol class="home-journey" aria-label="Recorrido de las Misiones de Arconte">
        {homeJourneyStages.map((stage, index) => (
          <li>
            <a href={stage.href}>
              <span class="home-journey__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="home-journey__chapter">{stage.chapter}</span>
              <strong>{stage.title}</strong>
              <p>{stage.summary}</p>
              <span class="home-journey__meta">{stage.versionLabel} · {stage.actCount} {stage.actCount === 1 ? 'acto' : 'actos'}</span>
              <span class="home-journey__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
      <div class="journey-footer">
        <p>¿Buscas las fichas editoriales de misiones concretas?</p>
        <a class="button button--outline" href="/misiones/">Abrir Misiones <span>↗</span></a>
      </div>
    </div>
  </section>

  <section id="atlas" class="section page-wrap atlas-section">
    <div class="section-heading"><div><p class="eyebrow">04 / GEOGRAFÍA E HISTORIA</p><h2>Atlas de <em>Teyvat</em></h2></div><a class="text-link" href="/atlas/">Explorar el Atlas <span>→</span></a></div>
    <p class="section-lead">Naciones, regiones y civilizaciones que dejaron su huella en el mundo.</p>
    <div class="atlas-grid">
      {nationEntries.map((entry) => (
        <a class:list={['atlas-card', `atlas-card--${entry.id}`]} href={entry.href}>
          <span class="atlas-kicker">{entry.subtitle.toUpperCase()}</span>
          <strong>{entry.name}</strong>
          <span class="atlas-discover">Descubrir <b>↗</b></span>
        </a>
      ))}
    </div>
  </section>

  <section id="misterios" class="mystery-band">
    <div class="page-wrap mystery-inner"><div><p class="eyebrow">05 / LO QUE AÚN NO SABEMOS</p><h2>Algunos secretos<br />siguen <em>esperando.</em></h2><p>Reúne pistas, contrasta fuentes y distingue lo confirmado de lo que todavía es una teoría.</p><a class="button button--outline" href="/misterios/">Entrar a Misterios <span>↗</span></a></div><div class="mystery-mark" aria-hidden="true"><span>✧</span><i></i><b></b></div></div>
  </section>

  <section id="buscar" class="search-band"><div class="page-wrap search-inner"><div><p class="eyebrow">EL ARCHIVO ESTÁ ABIERTO</p><h2>¿Qué estás buscando?</h2></div><form class="search-form" action="/buscar/"><label class="sr-only" for="q">Buscar en el archivo</label><input id="q" name="q" type="search" placeholder="Personaje, lugar, acontecimiento..." /><button type="submit" aria-label="Buscar">↗</button></form></div></section>
</SiteLayout>
