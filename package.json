{
  "name": "teyvat-archives",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "npm run check:editorial && astro check",
    "test": "node --experimental-strip-types --test tests/graph.test.mjs tests/editorial.test.mjs tests/reading-progress.test.mjs tests/content-revision.test.mjs",
    "check:editorial": "node --experimental-strip-types scripts/check-editorial.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "latest",
    "@astrojs/vue": "latest",
    "astro": "latest",
    "vue": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "pagefind": "^1.6.0",
    "typescript": "latest",
    "satteri": "0.11.7",
    "yaml": "2.9.1"
  }
}
